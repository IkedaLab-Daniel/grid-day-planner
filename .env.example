# Copy to .env.local and fill in from your Supabase project (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/test only. Never expose to the browser. Used by `npm run test:db` to create and delete test users.
SUPABASE_SERVICE_ROLE_KEY=

# Azure OpenAI for the chat helper (server-side only; never NEXT_PUBLIC_).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
